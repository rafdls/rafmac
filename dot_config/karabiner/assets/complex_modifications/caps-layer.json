{
  "title": "Caps Lock Nav Layer",
  "rules": [
    {
      "description": "Caps Lock as layer key (Escape when tapped alone)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "set_variable": { "name": "caps_layer", "value": 1 } }],
          "to_after_key_up": [
            { "set_variable": { "name": "caps_layer", "value": 0 } }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_arrow" }],
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "down_arrow" }],
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "up_arrow" }],
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_arrow" }],
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ]
        }
      ]
    }
  ]
}
